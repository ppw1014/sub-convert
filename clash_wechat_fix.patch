# ==============================================================================
# Patch 1: Rules Prepend Patch (进程与域名直连规则)
# ==============================================================================
--- a/rules/custom_rules.yaml
+++ b/rules/custom_rules.yaml
@@ -1,6 +1,28 @@
 prepend:
+  # 微信 macOS 进程直连（彻底免疫任何代理/CDN/分流异常）
+  - 'PROCESS-NAME,WeChat,DIRECT'
+  - 'PROCESS-NAME,WeChatAppEx,DIRECT'
+  - 'PROCESS-NAME,WeChatAppEx Helper,DIRECT'
+  - 'PROCESS-NAME,WeChatAppEx Helper (Renderer),DIRECT'
+  - 'PROCESS-NAME,WeChatAppEx Helper (GPU),DIRECT'
+  - 'PROCESS-PATH-REGEX,(?i).*wechat.*,DIRECT'
+  - 'PROCESS-PATH-REGEX,(?i).*weixin.*,DIRECT'
+
+  # 腾讯与微信全量多媒体 CDN 域名直连
+  - 'DOMAIN-SUFFIX,weixin.qq.com,DIRECT'
+  - 'DOMAIN-SUFFIX,wx.qq.com,DIRECT'
+  - 'DOMAIN-SUFFIX,wechat.com,DIRECT'
+  - 'DOMAIN-SUFFIX,qpic.cn,DIRECT'
+  - 'DOMAIN-SUFFIX,qlogo.cn,DIRECT'
+  - 'DOMAIN-SUFFIX,mmbiz.qpic.cn,DIRECT'
+  - 'DOMAIN-SUFFIX,mmbiz.qlogo.cn,DIRECT'
+  - 'DOMAIN-SUFFIX,mmbizgo.com,DIRECT'
+  - 'DOMAIN-SUFFIX,servicewechat.com,DIRECT'
+  - 'DOMAIN-SUFFIX,tenpay.com,DIRECT'
+  - 'DOMAIN-SUFFIX,qq.com,DIRECT'
+  - 'DOMAIN-SUFFIX,tencent.com,DIRECT'
+  - 'DOMAIN-SUFFIX,tencent-cloud.net,DIRECT'
+  - 'DOMAIN-SUFFIX,myqcloud.com,DIRECT'
+  - 'DOMAIN-KEYWORD,weixin,DIRECT'
+  - 'DOMAIN-KEYWORD,wechat,DIRECT'
+  - 'DOMAIN-KEYWORD,qpic,DIRECT'

# ==============================================================================
# Patch 2: Merge / DNS / Sniffer Patch (嗅探与 DNS 优化，精简 fake-ip-filter)
# ==============================================================================
--- a/merge/merge_template.yaml
+++ b/merge/merge_template.yaml
@@ -1,6 +1,41 @@
+sniffer:
+  enable: true
+  force-dns-mapping: true
+  parse-pure-ip: true
+  override-destination: false
+  sniff:
+    HTTP:
+      ports: [80, 8080-8880]
+      override-destination: true
+    TLS:
+      ports: [443, 8443]
+    QUIC:
+      ports: [443, 8443]
+
 dns:
+  enable: true
+  ipv6: true
+  enhanced-mode: fake-ip
+  fake-ip-range: 198.18.0.1/16
+  fake-ip-range6: fdfe:dcba:9876::1/64
   fake-ip-filter:
     - '*.lan'
     - '*.local'
     - '*.arpa'
     - 'time.*.com'
+    - 'time.*.apple.com'
+    - 'time.*.gov'
     - 'ntp.*.com'
+    - '*.pool.ntp.org'
     - '*.msftncsi.com'
     - 'www.msftconnecttest.com'
+    - 'captive.apple.com'
+    - 'detectportal.firefox.com'
+    - 'connectivitycheck.gstatic.com'
     - 'localhost.ptlogin2.qq.com'
     - '+.market.xiaomi.com'
-    - '+.weixin.qq.com'
-    - '+.wx.qq.com'
-    - '+.wechat.com'
-    - '+.weixinbridge.com'
-    - '+.emoji.qq.com'
-    - '+.qpic.cn'
-    - '+.mmbiz.qpic.cn'
-    - '+.mmbiz.qlogo.cn'
-    - '+.mmbizgo.com'
+    - 'stun.*'
+    - '*.stun.*'
+  default-nameserver:
+    - 223.5.5.5
+    - 119.29.29.29
+    - 114.114.114.114
+  nameserver:
+    - 223.5.5.5
+    - 119.29.29.29
+    - https://doh.pub/dns-query
+    - https://dns.alidns.com/dns-query
+  direct-nameserver:
+    - 223.5.5.5
+    - 119.29.29.29
